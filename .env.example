MANIM_EXECUTABLE=manim
# l/m/h/k/p — use l on small hosts to avoid OOM (SIGKILL / exit -9)
# MANIM_QUALITY=l
# MANIM_PREVIEW_OPEN=0
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Hosted Manim MCP (streamable HTTP) — required by agent.py
# HOSTED_MCP_URL=http://127.0.0.1:8000/mcp

# MCP server transport settings
# Use "streamable-http" for cloud/Docker deployment, "stdio" for local MCP clients
# MCP_TRANSPORT=streamable-http
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Optional: upload renders to Supabase Storage after each successful manim run (manim_server.py)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=manim-renders
SUPABASE_STORAGE_PREFIX=manim-renders/

# Default is public URLs (bucket should be public). For private buckets + signed URLs:
# SUPABASE_STORAGE_PUBLIC=0
# SUPABASE_SIGNED_URL_EXPIRES_SECONDS=604800